# ==========================================================
# Synapse AI - Environment Variables Reference
# ==========================================================

# Groq LLM API Key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Atlas Database URI
DB_TYPE=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.aqbwcvi.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=ai_news_aggregator

# Email Digest Delivery (Gmail SMTP)
EMAIL_ENABLED=true
MY_EMAIL=coderchaitanyaupadhyay@gmail.com
APP_PASSWORD=your_16_char_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Fallback Local SQLite (Optional)
DATABASE_URL=sqlite:///ai_news.db

# Pipeline Settings
DEFAULT_HOURS=24
DEFAULT_TOP_N=10


