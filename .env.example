# ==========================================================
# AI News Aggregator - Environment Configuration
# ==========================================================

# Groq API Key for high-speed LLM inference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration (MongoDB Atlas, PostgreSQL, or SQLite)
DB_TYPE=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.aqbwcvi.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=ai_news_aggregator
DATABASE_URL=sqlite:///ai_news.db

# Optional PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_news_aggregator

# Email Digest Delivery (Optional)
EMAIL_ENABLED=false
MY_EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password
RECIPIENTS=your_email@gmail.com

# Pipeline Defaults
DEFAULT_HOURS=24
DEFAULT_TOP_N=10
DIGEST_OUTPUT_DIR=output/digests
